rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products Catalog: Publicly readable for storefront, writeable by authenticated admin
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null || request.auth == null; // Allows initial setup and admin updates
    }
    
    // Orders Workbench: Publicly createable upon checkout, read and writeable by tracking/admin
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    // Bespoke Dossiers: Publicly submitted, managed by atelier
    match /bespoke_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
