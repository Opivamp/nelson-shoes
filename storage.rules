rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny for all paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions for authentication and file validation
    function isAuthenticated() {
      return request.auth != null;
    }

    // Evaluates custom token claims strictly (zero email-based authorization)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'master_artisan' ||
        request.auth.token.role == 'atelier_staff'
      );
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // Product photography path
    // Public can read product images on storefront
    // Only authenticated administrators can upload or delete assets
    match /products/{slug}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Bespoke reference assets path
    // Authenticated customers can upload & view only their own references
    // Admins have full oversight
    match /bespoke_references/{customerId}/{fileName} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == customerId);
      allow write: if (isAdmin() || (isAuthenticated() && request.auth.uid == customerId)) && isValidImage();
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == customerId);
    }

    // Guest bespoke references path
    // Write permitted for image types under 10MB; read restricted to atelier staff
    match /bespoke_references/guest/{fileName} {
      allow read: if isAdmin();
      allow write: if isValidImage();
      allow delete: if isAdmin();
    }
  }
}

